{
  "name": "puzzle",
  "version": "0.2.0",
  "description": "Generador de puzzles en SVG 1:1 para corte láser: medidas en cm + nº de piezas → vector con pestañas, ondas y formas rect/círculo. Jigsaw puzzle generator, laser-ready (Bun + TypeScript)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "dev:bg": "bun run scripts/dev.ts bg",
    "dev:stop": "bun run scripts/dev.ts stop",
    "dev:status": "bun run scripts/dev.ts status",
    "dev:logs": "bun run scripts/dev.ts logs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/client.ts --outdir dist --target browser --minify"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
